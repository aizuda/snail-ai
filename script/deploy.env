# ============================================================
# Snail AI — 部署环境变量（本地配置，不提交 Git）
# ============================================================
# deploy.sh 会自动加载此文件，可覆盖脚本内默认值

# 项目源码目录（默认: 脚本所在仓库根目录）
SNAIL_AI_PROJECT_DIR=

# Git 分支
SNAIL_AI_GIT_BRANCH=main

# Maven 构建参数
SNAIL_AI_MVN_OPTS=-DskipTests -T 1C

# Docker Compose 目录（默认: scripts/docker）
SNAIL_AI_COMPOSE_DIR=

# Docker 镜像名
SNAIL_AI_DOCKER_IMAGE=opensnail/snail-ai:latest

# 健康检查 URL
SNAIL_AI_HEALTH_URL=http://localhost:8900/snail-ai/actuator/health

# 健康检查重试次数 / 间隔（秒）
SNAIL_AI_HEALTH_RETRIES=30
SNAIL_AI_HEALTH_INTERVAL=3
