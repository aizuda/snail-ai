# ============================================================
# Snail AI — Docker Compose 环境变量
# ============================================================
# 复制此文件为 .env 并按需修改：
#   cp scripts/docker/.env.example scripts/docker/.env
# ============================================================

# ---------- 源代码目录（默认 compose 文件向上两级）----------
SNAIL_AI_SOURCE_DIR=../..

# ---------- Snail AI Server 镜像 ----------
SNAIL_AI_IMAGE=opensnail/snail-ai:latest
SNAIL_AI_AGENT_IMAGE=opensnail/snail-ai-agent-example:latest

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=snail_ai
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Ollama ----------
OLLAMA_PORT=11434
OLLAMA_MEMORY_LIMIT=8G

# ---------- Snail AI Server 端口 ----------
SNAIL_AI_HTTP_PORT=8900
SNAIL_AI_GRPC_PORT=18888

# ---------- Snail AI Server Java 参数 ----------
# 数据库 / Redis / MinIO / 加密 等所有 Spring 配置均通过 -D 传入
SNAIL_AI_JAVA_OPTS=-Xms512m -Xmx2g -Dspring.datasource.url=jdbc:mysql://mysql:3306/snail_ai?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8&useUnicode=true -Dspring.datasource.username=root -Dspring.datasource.password=root -Dspring.data.redis.host=redis -Dspring.data.redis.port=6379 -Dspring.data.redis.password= -Dsnail.ai.resource.minio.endpoint=http://minio:9000 -Dsnail.ai.resource.minio.access-key=minioadmin -Dsnail.ai.resource.minio.secret-key=minioadmin -Dsnail.ai.resource.minio.bucket=snail-ai -Dsnail.ai.crypto.key=0123456789abcdef0123456789abcdef -Dsnail.ai.crypto.iv=fedcba9876543210fedcba9876543210

# ---------- Snail AI Agent Example ----------
SNAIL_AI_AGENT_HTTP_PORT=8081
SNAIL_AI_AGENT_GRPC_PORT=18889
SNAIL_AI_AGENT_JAVA_OPTS=-Xms256m -Xmx1g
SNAIL_AI_AGENT_PARAMS=--server.port=8081
